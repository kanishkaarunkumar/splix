<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <queries><intent><action android:name="android.provider.Telephony.SMS_DELIVER" /></intent></queries>
  <application android:allowBackup="false">
    <receiver android:name="com.splix.capture.PaymentPromptReceiver" android:exported="false" />
    <service android:name="com.splix.capture.PaymentNotificationListener" android:exported="false" android:label="Splix private payment suggestions" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
    </service>
  </application>
</manifest>
